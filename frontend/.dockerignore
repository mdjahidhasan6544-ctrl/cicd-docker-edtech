# ============================================
# Frontend .dockerignore
# ============================================

# Version control
.git/
.gitignore
.gitattributes

# Local dependencies (rebuilt inside the image)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnp/
.pnp.js
.yarn/

# Build outputs (rebuilt inside the image)
dist/
build/
.cache/
.parcel-cache/
.vite/

# Secrets and env overrides — must NEVER enter the image
.env
.env.*
!.env.example

# Documentation (not needed in the image)
*.md
README.md
CHANGELOG.md
LICENSE
docs/

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo
.history/

# OS files
.DS_Store
Thumbs.db

# Tests
__tests__/
__mocks__/
*.test.js
*.test.jsx
*.spec.js
*.spec.jsx
vitest.config.*
jest.config.*

# Coverage
coverage/
.nyc_output/

# Dev tooling
.puku/

# Docker files themselves
Dockerfile
Dockerfile.*
.dockerignore
docker-compose*.yml
