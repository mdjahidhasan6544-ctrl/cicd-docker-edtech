# =====================================================
# Scholastica Backend — environment variables template
# Copy to .env (gitignored) and fill in real values.
# =====================================================

# ---- Required: MongoDB connection ----
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/scholastica?retryWrites=true&w=majority

# ---- Required: JWT signing secret ----
# Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-string

# ---- Server config ----
PORT=5000
NODE_ENV=production

# ---- CORS allowlist (comma-separated origins) ----
# In production behind nginx, this is the public URL the browser loads the app from.
CLIENT_URL=http://localhost

# ---- Admin bootstrap (optional) ----
# If both ADMIN_EMAIL and ADMIN_PASSWORD are set, ensureAdminAccount() will
# create the admin on first boot, or sync the password on subsequent boots.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong-password
ADMIN_NAME=Scholastica Admin
